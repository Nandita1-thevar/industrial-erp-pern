generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  role         Role
  createdAt    DateTime  @default(now())

  enquiries    Enquiry[]
}

model Customer {
  id            Int          @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String
  city          String
  createdAt     DateTime     @default(now())

  enquiries     Enquiry[]
  salesOrders   SalesOrder[]
}

model Product {
  id              Int              @id @default(autoincrement())
  code            String           @unique
  name            String
  category        String
  unit            String
  basePrice       Decimal          @db.Decimal(12, 2)

  inventory       Inventory?
  enquiryItems    EnquiryItem[]
  quotationItems  QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems   DispatchItem[]
}

model Inventory {
  id          Int      @id @default(autoincrement())
  productId   Int      @unique
  physicalQty Decimal  @default(0) @db.Decimal(12, 2)
  reservedQty Decimal  @default(0) @db.Decimal(12, 2)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Enquiry {
  id           Int           @id @default(autoincrement())
  enquiryNo    String        @unique
  customerId   Int
  createdById  Int
  enquiryDate  DateTime      @default(now())
  requiredDate DateTime
  notes        String?
  status       EnquiryStatus @default(NEW)
  createdAt    DateTime      @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  items        EnquiryItem[]
  quotation    Quotation?
}

model EnquiryItem {
  id         Int      @id @default(autoincrement())
  enquiryId  Int
  productId  Int
  quantity   Decimal  @db.Decimal(12, 2)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([enquiryId, productId])
}

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNo     String          @unique
  enquiryId       Int             @unique
  subtotal        Decimal         @db.Decimal(14, 2)
  discountAmount  Decimal         @db.Decimal(14, 2)
  gstAmount       Decimal         @db.Decimal(14, 2)
  grandTotal      Decimal         @db.Decimal(14, 2)
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  createdAt       DateTime        @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  items           QuotationItem[]
  salesOrder      SalesOrder?
}

model QuotationItem {
  id           Int       @id @default(autoincrement())
  quotationId  Int
  productId    Int
  quantity     Decimal   @db.Decimal(12, 2)
  unitPrice    Decimal   @db.Decimal(12, 2)
  discountPct  Decimal   @db.Decimal(5, 2)
  gstPct       Decimal   @db.Decimal(5, 2)
  lineAmount   Decimal   @db.Decimal(14, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model SalesOrder {
  id          Int         @id @default(autoincrement())
  orderNo     String      @unique
  quotationId Int         @unique
  customerId  Int
  orderDate   DateTime    @default(now())
  totalAmount Decimal     @db.Decimal(14, 2)
  status      OrderStatus @default(PENDING)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  items       SalesOrderItem[]
  dispatches  Dispatch[]
}

model SalesOrderItem {
  id           Int        @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Decimal    @db.Decimal(12, 2)
  unitPrice    Decimal    @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([salesOrderId, productId])
}

model Dispatch {
  id           Int             @id @default(autoincrement())
  dispatchNo   String          @unique
  salesOrderId Int
  dispatchDate DateTime        @default(now())
  vehicleNo    String
  driverName   String

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  items        DispatchItem[]
}

model DispatchItem {
  id          Int       @id @default(autoincrement())
  dispatchId  Int
  productId   Int
  quantity    Decimal   @db.Decimal(12, 2)

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([dispatchId, productId])
}